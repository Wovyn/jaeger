[Unit]
Description=Muse Pi YOLO MQTT sensor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=musecell
WorkingDirectory=/home/musecell/projects/jaeger
ExecStart=/home/musecell/projects/jaeger/venv/bin/python yolo_sensor.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
